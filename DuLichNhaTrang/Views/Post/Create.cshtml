@model DuLichNhaTrang.Models.ViewModels.PostCreateViewModel

@{
    ViewData["Title"] = "Đăng bài";
}

<div class="nt-page">
    <div class="container">
        <div class="nt-form-box nt-form-wide">
            <h1>Đăng bài giới thiệu địa điểm</h1>
            <p class="nt-form-note">
                Bài viết sau khi gửi sẽ ở trạng thái <strong>Chờ duyệt</strong>.
                Khi Admin duyệt, bài mới hiện trên trang chủ.
            </p>

            <form asp-controller="Post" asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TieuDe" class="form-label"></label>
                    <input asp-for="TieuDe" class="form-control" placeholder="Ví dụ: Bãi biển Nha Trang" />
                    <span asp-validation-for="TieuDe" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- Chọn loại địa điểm --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="HinhAnh" class="form-label"></label>
                    <input asp-for="HinhAnh" type="file" accept=".jpg,.jpeg,.png,.gif,.webp" class="form-control" />
                    <div class="form-text">Ảnh .jpg, .png, .gif, .webp, dung lượng tối đa 5 MB.</div>
                    <span asp-validation-for="HinhAnh" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MoTa" class="form-label"></label>

                    @* Khung soạn thảo có nút định dạng (Quill). Nội dung thật gửi lên nằm ở ô ẩn bên dưới *@
                    <div class="nt-editor">
                        <div id="moTaEditor"></div>
                    </div>
                    <input asp-for="MoTa" type="hidden" id="MoTaInput" />

                    <div class="form-text">
                        Có thể in đậm, in nghiêng, đổi cỡ chữ, màu chữ, tạo danh sách giống như trong Word.
                    </div>
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-nt-primary">Gửi bài chờ duyệt</button>
                <a asp-action="MyPosts" class="btn btn-link">Bài của tôi</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <link rel="stylesheet" href="~/lib/quill/quill.snow.css" />
    <script src="~/lib/quill/quill.js"></script>
    <script>
        // Mặc định Quill chỉ có 3 cỡ chữ (small/large/huge).
        // Đổi sang danh sách cỡ chữ theo số pixel để giống Word.
        var SizeStyle = Quill.import('attributors/style/size');
        SizeStyle.whitelist = ['12px', '14px', '16px', '18px', '20px', '24px', '28px', '32px', '36px', '48px'];
        Quill.register(SizeStyle, true);

        // Khởi tạo khung soạn thảo có thanh công cụ định dạng
        var quill = new Quill('#moTaEditor', {
            theme: 'snow',
            placeholder: 'Giới thiệu ngắn về địa điểm: ở đâu, có gì đặc biệt...',
            modules: {
                toolbar: [
                    [{ header: [1, 2, 3, false] }],
                    [{ size: ['12px', '14px', '16px', '18px', '20px', '24px', '28px', '32px', '36px', '48px', false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ color: [] }, { background: [] }],
                    [{ list: 'ordered' }, { list: 'bullet' }],
                    ['blockquote', 'link'],
                    ['clean']
                ]
            }
        });

        var moTaInput = document.getElementById('MoTaInput');

        // Nếu form bị lỗi (thiếu ảnh, thiếu loại...), đổ lại nội dung đã nhập vào khung soạn thảo
        if (moTaInput.value) {
            quill.clipboard.dangerouslyPasteHTML(moTaInput.value);
        }

        // Trước khi gửi form, chép nội dung trong khung soạn thảo vào ô ẩn để gửi lên server
        document.querySelector('form').addEventListener('submit', function () {
            moTaInput.value = quill.getSemanticHTML();
        });
    </script>
}
