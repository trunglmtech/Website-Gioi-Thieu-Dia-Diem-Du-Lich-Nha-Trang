@model List<DuLichNhaTrang.Models.Post>

@{
    ViewData["Title"] = "Bài của tôi";
}

<section class="nt-section">
    <div class="container">
        <h1 class="nt-section-title">Bài của tôi</h1>
        <p class="nt-section-sub">
            Chỉ hiển thị bài do chính bạn đăng. Bài mới đăng cần Admin duyệt mới lên trang chủ.
            Nếu muốn donate cho bài của người khác, bấm <strong>Donate</strong> ở bài đó trên trang chủ.
        </p>

        @if (TempData["ThongBao"] != null)
        {
            <div class="nt-alert mb-4">@TempData["ThongBao"]</div>
        }

        @if (Model.Count == 0)
        {
            <div class="nt-empty">
                <p class="mb-3">Bạn chưa đăng bài nào.</p>
                <a class="btn btn-nt-primary" asp-controller="Post" asp-action="Create">Đăng bài đầu tiên</a>
            </div>
        }
        else
        {
            <div class="mb-4">
                <a class="btn btn-nt-primary btn-sm" asp-controller="Post" asp-action="Create">Đăng bài mới</a>
            </div>

            <div class="nt-table-wrap">
                <table class="nt-table">
                    <thead>
                        <tr>
                            <th>Tiêu đề</th>
                            <th>Loại địa điểm</th>
                            <th>Ngày đăng</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model)
                        {
                            <tr>
                                <td class="nt-table-title">@post.TieuDe</td>
                                <td>@post.Category?.TenLoai</td>
                                <td>@post.NgayDang.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="nt-status @TrangThaiBaiViet.LopHienThi(post.TrangThai)">
                                        @TrangThaiBaiViet.TenHienThi(post.TrangThai)
                                    </span>
                                    @* Bài bị từ chối thì hiện lý do để thành viên biết cần sửa gì *@
                                    @if (post.TrangThai == "TuChoi" && !string.IsNullOrEmpty(post.LyDoTuChoi))
                                    {
                                        <div class="nt-reject-reason">Lý do: @post.LyDoTuChoi</div>
                                    }
                                </td>
                                <td>
                                    @if (post.TrangThai == "DaDuyet")
                                    {
                                        <a asp-controller="Home" asp-action="Details" asp-route-id="@post.Id">Xem</a>
                                        <span class="nt-muted-sep">|</span>
                                        <a asp-controller="Donation" asp-action="XacNhan"
                                           asp-route-id="@post.Id" asp-route-soTien="50000">Donate</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
