@model DuLichNhaTrang.Models.ViewModels.DatLaiMatKhauViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

@* Cùng phong cách thẻ nổi với trang đăng nhập *@
<section class="nt-auth">
    <div class="nt-auth-card">
        <div class="nt-auth-icon">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 1a4 4 0 0 0-4 4v1H7a3 3 0 0 0-3 3v3h2V9a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v3h2V9a3 3 0 0 0-3-3h-1V5a4 4 0 0 0-4-4zm0 10a3 3 0 0 0-1 5.83V22h2v-5.17A3 3 0 0 0 12 11z" />
            </svg>
        </div>

        <h1>Đặt lại mật khẩu</h1>

        <form asp-action="NhapMaDatLai" method="post" class="text-start">
            @* Giai đoạn demo: chưa gửi email nên hiện mã ngay trên màn hình.
               Khi làm phần gửi mail thì xóa ô thông báo này (mã sẽ đi qua email). *@
            @if (ViewBag.MaDemo != null)
            {
                <div class="nt-alert mb-3">
                    <p class="mb-1">Mã đặt lại mật khẩu của bạn là:</p>
                    <p class="mb-1 nt-code text-center">@ViewBag.MaDemo</p>
                    <p class="mb-0 small">
                        (Chưa gửi email nên mã hiện ở đây để demo. Mã dùng được trong 15 phút và chỉ một lần.)
                    </p>
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label">Tên đăng nhập</label>
                <div class="nt-vong-sang">
                    <input asp-for="TenDangNhap" class="form-control" readonly />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="MaDatLai" class="form-label">Mã đặt lại (6 số)</label>
                <div class="nt-vong-sang">
                    <input asp-for="MaDatLai" class="form-control" maxlength="6" inputmode="numeric"
                           placeholder="Ví dụ: 123456" />
                </div>
                <span asp-validation-for="MaDatLai" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MatKhauMoi" class="form-label">Mật khẩu mới</label>
                <div class="nt-password-field">
                    <input asp-for="MatKhauMoi" class="form-control" placeholder="Ít nhất 6 ký tự" autocomplete="new-password" />
                    <button type="button" class="nt-password-toggle" data-toggle-for="MatKhauMoi" aria-label="Hiện mật khẩu">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 5c-5 0-9 4.5-10 7 1 2.5 5 7 10 7s9-4.5 10-7c-1-2.5-5-7-10-7zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm0-2a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="MatKhauMoi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NhapLaiMatKhau" class="form-label">Nhập lại mật khẩu mới</label>
                <div class="nt-password-field">
                    <input asp-for="NhapLaiMatKhau" class="form-control" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                    <button type="button" class="nt-password-toggle" data-toggle-for="NhapLaiMatKhau" aria-label="Hiện mật khẩu">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 5c-5 0-9 4.5-10 7 1 2.5 5 7 10 7s9-4.5 10-7c-1-2.5-5-7-10-7zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm0-2a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="NhapLaiMatKhau" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-nt-primary">Đặt lại mật khẩu</button>
        </form>

        <div class="nt-auth-links mt-4">
            <a asp-action="QuenMatKhau">Xin mã khác</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Mỗi nút con mắt hiện / ẩn ô mật khẩu tương ứng
        document.querySelectorAll('.nt-password-toggle').forEach(function (nut) {
            nut.addEventListener('click', function () {
                var o = document.getElementById(nut.getAttribute('data-toggle-for'));
                var dangAn = o.type === 'password';
                o.type = dangAn ? 'text' : 'password';
                nut.classList.toggle('dang-hien', dangAn);
            });
        });
    </script>
}
