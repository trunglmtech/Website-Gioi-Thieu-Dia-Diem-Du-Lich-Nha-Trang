@model DuLichNhaTrang.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
}

<div class="nt-page">
    <div class="container">
        <div class="nt-form-box">
            <h1>Đăng ký tài khoản</h1>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label"></label>
                    <input asp-for="TenDangNhap" class="form-control" />
                    <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MatKhau" class="form-label"></label>
                    <input asp-for="MatKhau" class="form-control" />
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NhapLaiMatKhau" class="form-label"></label>
                    <input asp-for="NhapLaiMatKhau" class="form-control" />
                    <span asp-validation-for="NhapLaiMatKhau" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-nt-primary">Đăng ký</button>
                <a asp-action="Login" class="btn btn-link">Đã có tài khoản? Đăng nhập</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
