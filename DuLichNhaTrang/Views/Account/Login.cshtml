@model DuLichNhaTrang.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="nt-page">
    <div class="container">
        <div class="nt-form-box">
            <h1>Đăng nhập</h1>

            @if (TempData["ThongBao"] != null)
            {
                <div class="nt-alert mb-3">@TempData["ThongBao"]</div>
            }

            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label"></label>
                    <input asp-for="TenDangNhap" class="form-control" />
                    <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MatKhau" class="form-label"></label>
                    <input asp-for="MatKhau" class="form-control" />
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="GhiNho" class="form-check-input" />
                    <label asp-for="GhiNho" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-nt-primary">Đăng nhập</button>
                <a asp-action="Register" class="btn btn-link">Chưa có tài khoản? Đăng ký</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
