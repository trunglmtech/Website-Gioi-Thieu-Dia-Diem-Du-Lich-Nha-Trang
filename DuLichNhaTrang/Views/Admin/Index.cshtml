@model List<DuLichNhaTrang.Models.Post>

@{
    ViewData["Title"] = "Quản trị bài viết";
    var boLoc = ViewBag.TrangThai as string;
}

<section class="nt-section">
    <div class="container">
        <h1 class="nt-section-title">Quản trị bài viết</h1>
        <p class="nt-section-sub">
            Duyệt, từ chối hoặc xóa bài do thành viên đăng. Chỉ bài <strong>Đã duyệt</strong> mới hiện trên trang chủ.
        </p>

        @if (TempData["ThongBao"] != null)
        {
            <div class="nt-alert mb-4">@TempData["ThongBao"]</div>
        }

        @* Các nút lọc bài theo trạng thái *@
        <div class="nt-admin-filters mb-4">
            <a class="nt-admin-filter @(string.IsNullOrEmpty(boLoc) ? "active" : "")"
               asp-action="Index">Tất cả (@ViewBag.SoBaiTatCa)</a>
            <a class="nt-admin-filter @(boLoc == "ChoDuyet" ? "active" : "")"
               asp-action="Index" asp-route-trangThai="ChoDuyet">Chờ duyệt (@ViewBag.SoBaiChoDuyet)</a>
            <a class="nt-admin-filter @(boLoc == "DaDuyet" ? "active" : "")"
               asp-action="Index" asp-route-trangThai="DaDuyet">Đã duyệt (@ViewBag.SoBaiDaDuyet)</a>
            <a class="nt-admin-filter @(boLoc == "TuChoi" ? "active" : "")"
               asp-action="Index" asp-route-trangThai="TuChoi">Từ chối (@ViewBag.SoBaiTuChoi)</a>
        </div>

        @if (Model.Count == 0)
        {
            <div class="nt-empty">
                <p class="mb-0">Không có bài viết nào ở mục này.</p>
            </div>
        }
        else
        {
            <div class="nt-table-wrap">
                <table class="nt-table">
                    <thead>
                        <tr>
                            <th>Ảnh</th>
                            <th>Tiêu đề</th>
                            <th>Loại</th>
                            <th class="nt-col-optional">Người đăng</th>
                            <th class="nt-col-optional">Ngày đăng</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model)
                        {
                            var duongDanAnh = string.IsNullOrEmpty(post.HinhAnh)
                                ? Url.Content("~/images/sample/hero-nha-trang.jpg")
                                : Url.Content("~/" + post.HinhAnh);

                            <tr>
                                <td>
                                    <img src="@duongDanAnh" alt="@post.TieuDe" class="nt-admin-thumb" />
                                </td>
                                <td class="nt-table-title">
                                    <a asp-action="ChiTiet" asp-route-id="@post.Id" class="nt-admin-title-link">@post.TieuDe</a>
                                </td>
                                <td>@post.Category?.TenLoai</td>
                                <td class="nt-col-optional">@post.User?.TenDangNhap</td>
                                <td class="nt-col-optional">@post.NgayDang.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="nt-status @TrangThaiBaiViet.LopHienThi(post.TrangThai)">
                                        @TrangThaiBaiViet.TenHienThi(post.TrangThai)
                                    </span>
                                </td>
                                <td>
                                    <div class="nt-admin-actions">
                                        <a class="btn btn-nt-outline btn-sm" asp-action="ChiTiet" asp-route-id="@post.Id">Xem</a>

                                        @* Duyệt: chỉ hiện khi bài chưa được duyệt *@
                                        @if (post.TrangThai != "DaDuyet")
                                        {
                                            <form asp-action="Duyet" method="post">
                                                <input type="hidden" name="id" value="@post.Id" />
                                                <input type="hidden" name="boLoc" value="@boLoc" />
                                                <button type="submit" class="btn btn-nt-approve btn-sm">Duyệt</button>
                                            </form>
                                        }

                                        @* Từ chối: chỉ hiện khi bài chưa bị từ chối *@
                                        @if (post.TrangThai != "TuChoi")
                                        {
                                            <form asp-action="TuChoi" method="post">
                                                <input type="hidden" name="id" value="@post.Id" />
                                                <input type="hidden" name="boLoc" value="@boLoc" />
                                                <button type="submit" class="btn btn-nt-reject btn-sm">Từ chối</button>
                                            </form>
                                        }

                                        @* Xóa: hỏi lại trước khi xóa để tránh bấm nhầm *@
                                        <form asp-action="Xoa" method="post"
                                              onsubmit="return confirm('Xóa bài này? Thao tác không hoàn tác được.');">
                                            <input type="hidden" name="id" value="@post.Id" />
                                            <button type="submit" class="btn btn-nt-delete btn-sm">Xóa</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
