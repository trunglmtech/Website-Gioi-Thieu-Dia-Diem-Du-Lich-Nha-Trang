@{
    ViewData["Title"] = "Trang chủ";
}

<div class="p-5 mb-4 bg-light rounded-3 border">
    <h1 class="display-6">Khám phá du lịch Nha Trang</h1>
    <p class="lead">Nơi thành viên chia sẻ những địa điểm du lịch, ăn uống và vui chơi tại thành phố biển Nha Trang.</p>
    <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Đăng ký thành viên</a>
    <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Login">Đăng nhập</a>
</div>

<div class="alert alert-info">
    Danh sách bài viết sẽ được hiển thị ở bước tiếp theo của đồ án.
</div>
