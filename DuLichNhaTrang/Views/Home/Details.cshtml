@model DuLichNhaTrang.Models.Post

@{
    ViewData["Title"] = Model.TieuDe;
    var dangNoiBat = Model.FeaturedUntil != null && Model.FeaturedUntil > DateTime.Now;
    var duongDanAnh = string.IsNullOrEmpty(Model.HinhAnh)
        ? Url.Content("~/images/sample/hero-nha-trang.jpg")
        : Url.Content("~/" + Model.HinhAnh);

    // Bản đồ: chỉ hiện khi bài có tọa độ hợp lệ (dạng 12.2388,109.1967)
    bool coBanDo = !string.IsNullOrEmpty(Model.ToaDo) && DuLichNhaTrang.Controllers.PostController.LaToaDoHopLe(Model.ToaDo);
    var toaDo = coBanDo ? Model.ToaDo!.Trim() : "";
}

<section class="nt-detail">
    <div class="container">
        <a class="text-decoration-none" asp-controller="Home" asp-action="Index">&larr; Về danh sách địa điểm</a>

        <img class="nt-detail-img mt-3" src="@duongDanAnh" alt="@Model.TieuDe" />

        <h1 class="nt-detail-title">@Model.TieuDe</h1>

        <div class="nt-detail-meta">
            <span class="me-3">Loại: <strong>@Model.Category?.TenLoai</strong></span>
            <span class="me-3">Đăng ngày: @Model.NgayDang.ToString("dd/MM/yyyy")</span>
            <span>Người đăng: <strong>@Model.User?.TenDangNhap</strong></span>
        </div>

        @if (dangNoiBat)
        {
            <div class="nt-alert mb-4">
                Bài viết này đang được ưu tiên hiển thị đến ngày
                <strong>@Model.FeaturedUntil?.ToString("dd/MM/yyyy")</strong>.
            </div>
        }

        @if (TempData["ThongBao"] != null)
        {
            <div class="nt-alert mb-4">@TempData["ThongBao"]</div>
        }

        <div class="nt-detail-text">
            @* Mô tả đã được lọc HTML khi lưu nên hiển thị được định dạng in đậm, in nghiêng... *@
            @Html.Raw(Model.MoTa)
        </div>

        @* ---------- Vị trí trên bản đồ (khung có sẵn, chỉ tải bản đồ khi bấm) ---------- *@
        @if (coBanDo)
        {
            <section class="nt-map-box mt-4">
                <h2 class="nt-map-title">Vị trí trên bản đồ</h2>

                <div class="nt-map-frame" id="khungBanDo" data-toa-do="@toaDo" data-ten="@Model.TieuDe">
                    <div class="nt-map-placeholder">
                        <span class="nt-map-pin">📍</span>
                        <p class="mb-2">Bản đồ chỉ tải khi cần, để trang nhanh hơn.</p>
                        <button type="button" class="btn btn-nt-primary btn-sm" id="nutTaiBanDo">
                            Xem vị trí trên bản đồ
                        </button>
                    </div>
                </div>

                <div class="nt-map-actions">
                    <span class="nt-map-coord">Tọa độ: @toaDo</span>
                    <a class="btn btn-nt-outline btn-sm"
                       href="https://www.google.com/maps/search/?api=1&amp;query=@toaDo"
                       target="_blank" rel="noopener">Mở bằng Google Maps</a>
                </div>
            </section>
        }

        <div class="mt-4 d-flex flex-wrap gap-2">
            <a class="btn btn-nt-outline" asp-controller="Home" asp-action="Index">Xem các địa điểm khác</a>

            @* Chỉ thành viên đã đăng nhập mới thấy nút donate *@
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a class="btn btn-nt-gold" asp-controller="Donation" asp-action="XacNhan"
                   asp-route-id="@Model.Id" asp-route-soTien="50000">
                    Donate 50.000 đồng (mô phỏng)
                </a>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Chỉ tải bản đồ khi người dùng bấm nút (tránh tải bản đồ ở mọi lần mở trang)
        var nutBanDo = document.getElementById('nutTaiBanDo');
        if (nutBanDo) {
            nutBanDo.addEventListener('click', function () {
                var khung = document.getElementById('khungBanDo');
                var toaDo = khung.getAttribute('data-toa-do').split(',');
                var viDo = parseFloat(toaDo[0]);
                var kinhDo = parseFloat(toaDo[1]);
                var lech = 0.01; // xem rộng khoảng hơn 1 km quanh địa điểm

                var diaChi = 'https://www.openstreetmap.org/export/embed.html'
                    + '?bbox=' + (kinhDo - lech) + ',' + (viDo - lech) + ',' + (kinhDo + lech) + ',' + (viDo + lech)
                    + '&layer=mapnik&marker=' + viDo + ',' + kinhDo;

                var iframe = document.createElement('iframe');
                iframe.src = diaChi;
                iframe.title = 'Bản đồ ' + khung.getAttribute('data-ten');
                iframe.loading = 'lazy';

                khung.innerHTML = '';
                khung.appendChild(iframe);
            });
        }
    </script>
}
