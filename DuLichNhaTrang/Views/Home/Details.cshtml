@model DuLichNhaTrang.Models.Post

@{
    ViewData["Title"] = Model.TieuDe;
    var dangNoiBat = Model.FeaturedUntil != null && Model.FeaturedUntil > DateTime.Now;
    var duongDanAnh = string.IsNullOrEmpty(Model.HinhAnh)
        ? Url.Content("~/images/sample/hero-nha-trang.jpg")
        : Url.Content("~/" + Model.HinhAnh);
}

<section class="nt-detail">
    <div class="container">
        <a class="text-decoration-none" asp-controller="Home" asp-action="Index">&larr; Về danh sách địa điểm</a>

        <img class="nt-detail-img mt-3" src="@duongDanAnh" alt="@Model.TieuDe" />

        <h1 class="nt-detail-title">@Model.TieuDe</h1>

        <div class="nt-detail-meta">
            <span class="me-3">Loại: <strong>@Model.Category?.TenLoai</strong></span>
            <span class="me-3">Đăng ngày: @Model.NgayDang.ToString("dd/MM/yyyy")</span>
            <span>Người đăng: <strong>@Model.User?.TenDangNhap</strong></span>
        </div>

        @if (dangNoiBat)
        {
            <div class="nt-alert mb-4">
                Bài viết này đang được ưu tiên hiển thị đến ngày
                <strong>@Model.FeaturedUntil?.ToString("dd/MM/yyyy")</strong>.
            </div>
        }

        @if (TempData["ThongBao"] != null)
        {
            <div class="nt-alert mb-4">@TempData["ThongBao"]</div>
        }

        <div class="nt-detail-text">
            @* Mô tả đã được lọc HTML khi lưu nên hiển thị được định dạng in đậm, in nghiêng... *@
            @Html.Raw(Model.MoTa)
        </div>

        <div class="mt-4 d-flex flex-wrap gap-2">
            <a class="btn btn-nt-outline" asp-controller="Home" asp-action="Index">Xem các địa điểm khác</a>

            @* Chỉ thành viên đã đăng nhập mới thấy nút donate *@
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a class="btn btn-nt-gold" asp-controller="Donation" asp-action="XacNhan"
                   asp-route-id="@Model.Id" asp-route-soTien="50000">
                    Donate 50.000 đồng (mô phỏng)
                </a>
            }
        </div>
    </div>
</section>
