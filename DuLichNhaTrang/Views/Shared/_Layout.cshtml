<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Du lịch Nha Trang</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DuLichNhaTrang.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="nt-header">
        <nav class="navbar navbar-expand-sm nt-navbar">
            <div class="container">
                <a class="nt-brand" asp-controller="Home" asp-action="Index">Nha<span>Trang</span></a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse justify-content-between flex-grow-1">
                    <ul class="navbar-nav ms-sm-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        @* Chỉ Admin mới thấy mục Quản trị *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">Quản trị</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-sm-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link nt-hello">Xin chào, <strong>@User.Identity.Name</strong></span>
                            </li>
                            <li class="nav-item">
                                @* Đăng xuất phải dùng form POST để an toàn *@
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-nt-outline btn-sm">Đăng xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-nt-primary btn-sm" asp-controller="Account" asp-action="Register">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @* Không bọc container ở đây để trang chủ có thể dùng ảnh hero tràn viền *@
    <main role="main">
        @RenderBody()
    </main>

    <footer class="nt-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-3">
            <div>
                <div class="nt-footer-brand mb-2">Nha<span>Trang</span></div>
                <p>Website giới thiệu địa điểm du lịch Nha Trang - đồ án ASP.NET MVC.</p>
            </div>
            <div class="d-flex flex-column gap-1">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                <a asp-controller="Account" asp-action="Register">Đăng ký</a>
            </div>
        </div>
        <div class="container mt-3">
            <p class="small">&copy; 2026 - Website giới thiệu du lịch Nha Trang</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
